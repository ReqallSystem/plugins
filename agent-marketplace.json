    {
      "id": "reqall-hermes",
      "name": "reqall",
      "displayName": "Reqall for Hermes Agent",
      "agent": "hermes",
      "description": "Python plugin: hooks, skills, HTTP reqall tool, optional host MCP. Installs into the current $HERMES_HOME/plugins; run ensure-install.py for other profiles that enabled reqall.",
      "source": {
        "type": "git",
        "url": "https://github.com/ReqallSystem/hermes-plugin.git"
      },
      "homepage": "https://github.com/ReqallSystem/hermes-plugin",
      "install": {
        "notes": [
          "hermes plugins install ReqallSystem/hermes-plugin --enable",
          "python3 $HERMES_HOME/plugins/reqall/ensure-install.py",
          "Restart that profile's gateway from an external shell, then /new"
        ]
      }
    },
    {
      "id": "reqall-cline",
      "name": "reqall",
      "displayName": "Reqall for Cline",
      "agent": "cline",
      "description": "Cline SDK plugin (CLI/Kanban) plus VS Code file hooks, skills, rule, and MCP config for persistent project memory.",
      "source": {
        "type": "git",
        "url": "https://github.com/ReqallSystem/cline_plugin.git"
      },
      "homepage": "https://github.com/ReqallSystem/cline_plugin",
      "install": {
        "notes": [
          "CLI: cline plugin install git:github.com/ReqallSystem/cline_plugin",
          "VS Code/JetBrains: npx github:ReqallSystem/cline_plugin install, then add `npx github:ReqallSystem/cline_plugin mcp-config` to cline_mcp_settings.json"
        ]
      }
    },
    {
      "id": "reqall-opencode",
      "name": "reqall",
      "displayName": "Reqall for OpenCode",
      "agent": "opencode",
      "description": "OpenCode server plugin: MCP server, skills, commands, per-message recall, and a persist follow-up on idle.",
      "source": {
        "type": "git",
        "url": "https://github.com/ReqallSystem/opencode_plugin.git"
      },
      "homepage": "https://github.com/ReqallSystem/opencode_plugin",
      "install": {
        "notes": [
          "Add \"github:ReqallSystem/opencode_plugin\" to the plugin array in opencode.json"
        ]
      }
    },
    {
      "id": "reqall-openclaw",
      "name": "reqall",
      "displayName": "Reqall for OpenClaw",
      "agent": "openclaw",
      "description": "Native OpenClaw plugin: recall before prompts, a persist revision before finalize, skills, and a declared Reqall MCP server.",
      "source": {
        "type": "git",
        "url": "https://github.com/ReqallSystem/openclaw_plugin.git"
      },
      "homepage": "https://github.com/ReqallSystem/openclaw_plugin",
      "install": {
        "notes": [
          "openclaw plugins install git:github.com/ReqallSystem/openclaw_plugin --accept-capabilities",
          "openclaw config set plugins.entries.reqall.hooks.allowConversationAccess true",
          "openclaw mcp login reqall (or override mcp.servers.reqall with an API-key header)"
        ]
      }
    }
  ]
